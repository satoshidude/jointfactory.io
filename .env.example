# Local development. Copy to .env — .env and data/ are gitignored.
#
# Pull a fresh DB snapshot with:
#   ssh <vps> "cd /home/webmaster/jointfactory.io && sqlite3 data/jointfactory.db \".backup '/tmp/jf.db'\""
#   scp <vps>:/tmp/jf.db data/jointfactory.db
#
# Then:  npm run dev:server   (API on 3421)
#        npm run dev          (Vite, proxies /api to localhost:3421)

DB_PATH=./data/jointfactory.db
PORT=3421
JWT_SECRET=local-dev-only-not-the-production-secret

# Never publish to the real relays from a dev server: without this the bot posts
# lottery reminders, win notes and owner DMs under the production identity.
JF_NOSTR_OFFLINE=1

# Deliberately unset locally — NOSTR_ZAP_NSEC, LNBITS_* . Deposits and
# withdrawals fail without them, which is correct for economy testing.
